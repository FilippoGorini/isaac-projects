<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vla_kinova_jtc_streamer</name>
  <version>0.0.0</version>
  <description>Minimal reliable-timing C++ streamer: oversamples the 30 Hz VLA arm plan and streams single short-horizon linear-interpolated points to the Kinova JTC (passthrough).</description>
  <maintainer email="philgo313@gmail.com">filippo</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>trajectory_msgs</depend>
  <depend>builtin_interfaces</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
