  <version>0.0.0</version>
  <description>Camera bringup for the Kinova VLA tabletop project (ZED 2 + Kinova wrist camera, RGB only).</description>
  <maintainer email="filippogorini7@gmail.com">filippo</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>kinova_vision</exec_depend>
