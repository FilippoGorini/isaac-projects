                custom double[] inputs:effortCommand
                prepend double[] inputs:effortCommand.connect = </World/kinova_gen3_6dof_2f85/ActionGraph/SubscriberJointState.outputs:effortCommand>
                custom uint inputs:execIn (
                    customData = {
                        bool isExecution = 1
                    }
                )
                prepend uint inputs:execIn.connect = </World/kinova_gen3_6dof_2f85/ActionGraph/SubscriberJointState.outputs:execOut>
                custom token[] inputs:jointNames
                prepend token[] inputs:jointNames.connect = </World/kinova_gen3_6dof_2f85/ActionGraph/SubscriberJointState.outputs:jointNames>
                custom double[] inputs:positionCommand
                prepend double[] inputs:positionCommand.connect = </World/kinova_gen3_6dof_2f85/ActionGraph/SubscriberJointState.outputs:positionCommand>
                custom string inputs:script = '''import omni.graph.core as og

def compute(db):
    # Retrieve inputs from the ros subscriber
    names = list(db.inputs.jointNames)
    pos = list(db.inputs.positionCommand)
    vel = list(db.inputs.velocityCommand)
    eff = list(db.inputs.effortCommand)

    # Only command the joints which exists in the articulation 
    # We want to keep only the joints which actually have a joint drive
    # For the gripper these are just the left and right knuckle joints, the other ones are now all passive
    valid_joints = [
        "joint_1", "joint_2", "joint_3", "joint_4", "joint_5", "joint_6",
        "robotiq_85_left_knuckle_joint", "robotiq_85_right_knuckle_joint"
    ]

    out_names, out_pos, out_vel, out_eff = [], [], [], []

    # Keep only the valid joints
    for i, name in enumerate(names):
        if name in valid_joints:
            out_names.append(name)
            if len(pos) > i: out_pos.append(pos[i])
            if len(vel) > i: out_vel.append(vel[i])
            if len(eff) > i: out_eff.append(eff[i])

    db.outputs.jointNames = out_names
    db.outputs.positionCommand = out_pos
    db.outputs.velocityCommand = out_vel
    db.outputs.effortCommand = out_eff
    db.outputs.execOut = db.inputs.execIn

    return True'''
                custom token inputs:scriptPath
                custom bool inputs:usePath
                custom double[] inputs:velocityCommand
                prepend double[] inputs:velocityCommand.connect = </World/kinova_gen3_6dof_2f85/ActionGraph/SubscriberJointState.outputs:velocityCommand>
                token node:type = "omni.graph.scriptnode.ScriptNode"
