        )
        {
            custom double[] inputs:armEfforts
            prepend double[] inputs:armEfforts.connect = </kinova_gen3_6dof_2f85/ROS2_Physics_Graph/SubscriberArmState.outputs:effortCommand>
            custom token[] inputs:armNames
            prepend token[] inputs:armNames.connect = </kinova_gen3_6dof_2f85/ROS2_Physics_Graph/SubscriberArmState.outputs:jointNames>
            custom double[] inputs:armPositions
            prepend double[] inputs:armPositions.connect = </kinova_gen3_6dof_2f85/ROS2_Physics_Graph/SubscriberArmState.outputs:positionCommand>
            custom double[] inputs:armVelocities
            prepend double[] inputs:armVelocities.connect = </kinova_gen3_6dof_2f85/ROS2_Physics_Graph/SubscriberArmState.outputs:velocityCommand>
            custom uint inputs:execIn (
                customData = {
                    bool isExecution = 1
                }
            )
            prepend uint inputs:execIn.connect = </kinova_gen3_6dof_2f85/ROS2_Physics_Graph/on_physics_step.outputs:step>
            custom double[] inputs:gripperEfforts
            prepend double[] inputs:gripperEfforts.connect = </kinova_gen3_6dof_2f85/ROS2_Physics_Graph/SubscriberGripperState.outputs:effortCommand>
            custom token[] inputs:gripperNames
            prepend token[] inputs:gripperNames.connect = </kinova_gen3_6dof_2f85/ROS2_Physics_Graph/SubscriberGripperState.outputs:jointNames>
            custom double[] inputs:gripperPositions
            prepend double[] inputs:gripperPositions.connect = </kinova_gen3_6dof_2f85/ROS2_Physics_Graph/SubscriberGripperState.outputs:positionCommand>
            custom double[] inputs:gripperVelocities
            prepend double[] inputs:gripperVelocities.connect = </kinova_gen3_6dof_2f85/ROS2_Physics_Graph/SubscriberGripperState.outputs:velocityCommand>
            custom string inputs:script = '''import omni.graph.core as og
import numpy as np

def compute(db):
    """
    Inputs required on the node:
    - armNames (string[]): Joint names from /isaac_arm_commands
    - armPositions (double[]): Positions from /isaac_arm_commands
    - armVelocities (double[]): Velocities from /isaac_arm_commands
    - armEfforts (double[]): Efforts from /isaac_arm_commands
    
    - gripperNames (string[]): Joint names from /isaac_gripper_commands
    - gripperPositions (double[]): Positions from /isaac_gripper_commands
    - gripperVelocities (double[]): Velocities from /isaac_gripper_commands
    - gripperEfforts (double[]): Efforts from /isaac_gripper_commands

    Outputs:
    - jointNames (string[])
    - positionCommand (double[])
    - velocityCommand (double[])
    - effortCommand (double[])
    """
    
    # Get arm data and convert to list
    names = list(db.inputs.armNames)
    pos = list(db.inputs.armPositions)
    vel = list(db.inputs.armVelocities)
    eff = list(db.inputs.armEfforts)

    # Define target gripper joints (only the ones that have a joint drive)
    target_gripper_joints = [
        "robotiq_85_left_knuckle_joint", 
        "robotiq_85_right_knuckle_joint"
    ]

    # Filter and append the gripper data
    g_names = db.inputs.gripperNames
    g_pos = db.inputs.gripperPositions
    g_vel = db.inputs.gripperVelocities
    g_eff = db.inputs.gripperEfforts

    if len(g_names) > 0:
        for i, name in enumerate(g_names):
            if name in target_gripper_joints:
                names.append(name)
                # Safely append if data exists at this index
                if i < len(g_pos): pos.append(g_pos[i])
                if i < len(g_vel): vel.append(g_vel[i])
                if i < len(g_eff): eff.append(g_eff[i])

    # Output merged commands
    db.outputs.jointNames = names
    db.outputs.positionCommand = pos
    db.outputs.velocityCommand = vel
    db.outputs.effortCommand = eff

    return True'''
            custom token inputs:scriptPath
            custom bool inputs:usePath
            token node:type = "omni.graph.scriptnode.ScriptNode"
            int node:typeVersion = 2
            custom double[] outputs:effortCommand
            custom uint outputs:execOut (
                customData = {
                    bool isExecution = 1
                }
